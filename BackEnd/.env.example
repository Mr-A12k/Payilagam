# ──────────────────────────────────────────────
# TaskPro BackEnd — Environment Configuration Example
# ──────────────────────────────────────────────

# Server Port (Render automatically supplies PORT in production; default 5005 for local)
PORT=5005

# PostgreSQL Connection String (Neon.tech / Supabase / Local PostgreSQL)
# Example for Neon: postgresql://neondb_owner:npg_xyz@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskpro?schema=public"

# JWT Secret for authentication token signing (Generate a secure string for production)
JWT_SECRET="taskpro_jwt_secret_key_change_in_production_super_secure_123"

# Frontend URL for CORS (Set to your Vercel deployment URL in Render)
# Supports comma-separated URLs, e.g.: http://localhost:5173,https://taskpro-ui.vercel.app
FRONTEND_URL="http://localhost:5173,https://taskpro-ui.vercel.app"

# (Optional) External AI / Search Keys
# TAVILY_API_KEY=""
# REDIS_URL="redis://localhost:6379"
# REDIS_INDEX_NAME="taskpro-edu-docs"
# OLLAMA_BASE_URL="http://localhost:11434"
